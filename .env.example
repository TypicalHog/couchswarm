TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Same shared secret as coturn's static-auth-secret. Keep it server-side.
COUCHSWARM_TURN_SECRET=
COUCHSWARM_TURN_URLS=
# STUN server(s) for reflexive candidates, comma-separated. Entries without the
# stun: scheme are ignored; an empty result falls back to stun:stun.l.google.com:19302.
# A coturn relay also answers STUN on 3478.
COUCHSWARM_STUN_URLS=
# Set a public HTTPS ZIP URL. A local preview that ran npm run build:helper should set COUCHSWARM_HELPER_DOWNLOAD_URL=/downloads/CouchSwarm-Helper-win-x64.zip.
COUCHSWARM_HELPER_DOWNLOAD_URL=
# Public origin of this deployment, scheme and host with no trailing slash (https://couch.example).
# It overrides the derived helper pairing-link origin; set it when a reverse proxy rewrites the
# upstream Host or reaches CouchSwarm on a non-loopback address, since x-forwarded-host is honoured
# only over loopback. Not the standalone helper's COUCHSWARM_ORIGIN (README.md), a different setting.
COUCHSWARM_PUBLIC_ORIGIN=
