{
  "name": "couchswarm",
  "version": "1.1.3",
  "private": true,
  "license": "Unlicense OR MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "browserslist": [
    "chrome >= 116",
    "edge >= 116",
    "firefox >= 124",
    "safari >= 17.4"
  ],
  "scripts": {
    "predev": "node scripts/prepare-streaming.mjs && node scripts/migrate-database.mjs",
    "prebuild": "node scripts/prepare-streaming.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/ice.test.ts tests/remote-helper-client.test.ts tests/subtitles.test.ts tests/sync.test.ts tests/video-files.test.ts",
    "test:rooms": "node --test tests/rooms.test.mjs tests/host-presence.test.mjs",
    "test:mkv": "node --test tests/mkv.test.mjs",
    "test:helper": "node --test tests/helper.test.mjs tests/remote-wire.test.mjs",
    "test:migrate": "node --test tests/migrate.test.mjs",
    "test:patches": "node --test tests/playsvideo-patches.test.mjs",
    "test:remote": "node --test tests/remote-helper.test.mjs",
    "test:relay": "node scripts/check-relay.mjs",
    "test:suites": "node -e \"const scripts=JSON.stringify(require('./package.json').scripts);const missing=require('fs').readdirSync('tests').filter(f=>(f.endsWith('.test.ts')||f.endsWith('.test.mjs'))&&!scripts.includes('tests/'+f));if(missing.length){console.error('No npm script runs: '+missing.join(', '));process.exit(1);}\"",
    "test:offline": "npm run test:suites && npm test && npm run test:mkv && npm run test:helper && npm run test:migrate && npm run test:patches",
    "helper": "node helper/server.mjs",
    "helper:desktop": "node helper/desktop.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "dev": "next dev --webpack --port 3001",
    "build": "node scripts/migrate-database.mjs && next build --webpack",
    "start": "next start",
    "db:migrate": "node scripts/migrate-database.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.helper.json",
    "lint": "oxlint",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@libsql/client": "0.18.0",
    "@thaunknown/simple-peer": "10.1.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "bittorrent-protocol": "5.0.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "parse-torrent": "11.0.24",
    "playsvideo": "0.4.7",
    "range-parser": "1.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "ut_metadata": "5.0.1",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "mediabunny": "file:vendor/mediabunny-1.38.1-cd3cd2b.tgz",
    "memory-chunk-store": "1.3.5",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "mediabunny": "$mediabunny"
  },
  "type": "module"
}
